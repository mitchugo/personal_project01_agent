{
  "name": "chigzio-ai-agent-security-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LOCAL-ONLY demonstration UI for the Project 1 AI agent security lab. Not for deployment.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
