# Example configuration. Copy to .env for local use. NEVER commit .env.
# Nothing in Session 1 reads these values yet.

# Runtime environment label. This project only supports local lab use.
APP_ENV=local

# Identity mode. "local-fixture" = simulated server-side identity for development.
# This is NOT authentication and must never be described as production auth.
IDENTITY_MODE=local-fixture

LOG_LEVEL=INFO

# Planned SQLite location (synthetic data only). Not used yet.
DATABASE_PATH=data/lab.db

# Agent runtime (Session 6). Unset/"none" = agent off; /chat returns a fixed reply.
AGENT_PROVIDER=none
AGENT_MODEL=claude-sonnet-5-5
# Model substitution on refusal: "off" (default) or "default" (only with explicit approval).
AGENT_MODEL_FALLBACK=off

# Read by the Anthropic SDK from the process environment. The app never reads .env
# automatically: set it as a real environment variable. Never commit a value here.
ANTHROPIC_API_KEY=
# Never set ANTHROPIC_LOG=debug outside isolated debugging: SDK debug logs may include request details.
